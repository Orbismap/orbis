    "test": "vitest run",
    "smoke": "vite build --outDir dist-smoke --emptyOutDir && node test/smoke.mjs"
  },
  "packageManager": "pnpm@10.29.1",
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "maplibre-gl": "^6.17.0",
