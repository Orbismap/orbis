    "preact": "^10.29.8",
    "satellite.js": "^7.1.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.6.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
