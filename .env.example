# All optional. Defaults point to the public R2 hosts (see src/data/endpoints.ts).
VITE_LIVE_BASE=
VITE_DATA_BASE=
VITE_OSM_BASE=
VITE_WETTER_BASE=
VITE_ASSETS_BASE=
# CORS proxy for sources without CORS headers (adsb.lol, overpass, NOAA …). Default: the Orbismap worker.
VITE_PROXY_URL=
# Aircraft endpoint template with {lat} {lon} {nm}; replaces the proxied adsb.lol / adsb.fi defaults.
VITE_ADSB_URL=
