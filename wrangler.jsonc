{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbis-map",
  "compatibility_date": "2026-11-01",
  // Static site: Vite builds to dist/, Cloudflare serves it directly (no Worker script).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Deploying with this block creates the DNS record for maps.maltee.dev automatically
  // (the zone maltee.dev must be on this Cloudflare account). Do NOT add the record by hand.
  // Remove or comment out "routes" to deploy to the private *.workers.dev URL only.
  "routes": [
    { "pattern": "maps.maltee.dev", "custom_domain": true },
    // Same build, weather mode (see src/entry.ts): its own origin, its own installable PWA.
    { "pattern": "wetter.maltee.dev", "custom_domain": true },
    // Bus & Bahn (see src/entry.ts: hostname bahn.*). Needs https://bahn.maltee.dev in ALLOWED_ORIGINS of the push worker.
    { "pattern": "bahn.maltee.dev", "custom_domain": true },
    // Orbis Find: the next bicycle stand nearby (see src/entry.ts: hostname find.*).
    { "pattern": "find.maltee.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
